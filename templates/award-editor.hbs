<section class="sta-settings-form sta-award-editor">
  <h3 class="sta-award-editor-title">{{editorTitle}}</h3>
  <p class="hint">{{editorHint}}</p>

  <div class="sta-award-editor-toolbar">
    <button type="button" class="dialog-button" data-action="create-award">
      <i class="fa-solid fa-plus"></i>
      {{createLabel}}
    </button>
  </div>

  {{#if hasAwards}}
    <div class="sta-award-grid">
      {{#each awards}}
        <article class="sta-award-card {{#unless enabled}}is-disabled{{/unless}}" data-award-action="{{action}}">
          <label class="sta-award-card-toggle" title="{{localize "sta-officers-log.settings.customSpendOptions.toggleEnabled"}}">
            <input type="checkbox" class="sta-award-card-enable" data-award-action="{{action}}" {{#if enabled}}checked{{/if}} />
          </label>
          <div class="sta-award-card-main" role="button" tabindex="0" data-award-action="{{action}}">
            <header class="sta-award-card-header">
              <span class="sta-award-card-name">{{name}}</span>
              <span class="sta-award-card-cost">{{costLabel}}</span>
            </header>
            <p class="sta-award-card-desc">{{descriptionPreview}}</p>
          </div>
          {{#unless isBuiltIn}}
            <button type="button" class="sta-award-card-remove sta-danger" data-action="remove-award" data-award-action="{{action}}" title="{{localize "sta-officers-log.settings.customSpendOptions.removeAward"}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          {{/unless}}
        </article>
      {{/each}}
    </div>
  {{else}}
    <p class="hint">{{emptyLabel}}</p>
  {{/if}}

  <footer class="form-footer">
    <button type="button" class="dialog-button" data-action="close-award-editor">
      <i class="fa-solid fa-xmark"></i>
      {{closeLabel}}
    </button>
  </footer>
</section>
