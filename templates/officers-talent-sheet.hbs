<div class="officers-talent-sheet">
  <div class="ol-body">
    <section class="ol-section">
      <div class="ol-header-row">
        <img class="ol-log-img profile-img"
             src="{{item.img}}"
             data-edit="img"
             data-action="editImage"
             title="{{item.name}}" />
        <div class="ol-header-fields">
          <input name="name" type="text" value="{{item.name}}"
                 placeholder="{{localize 'sta.item.genericitem.name'}}" />
        </div>
      </div>
    </section>

    <section class="ol-section">
      <div class="sta-talent-req-compact">
        <div class="sta-talent-req-compact-summary">{{requirementSummary}}</div>
        <button type="button" class="button" data-action="onToggleEdit">
          {{#if compactMode}}
            {{localize "sta-officers-log.talents.sheet.edit"}}
          {{else}}
            {{localize "sta-officers-log.talents.sheet.done"}}
          {{/if}}
        </button>
      </div>
      {{#each conditionSummaries as |cond|}}
      <div class="sta-talent-req-condition-summary">{{cond}}</div>
      {{/each}}

      {{#unless compactMode}}
      <div class="sta-talent-type-row">
        <label class="sta-talent-type-label">{{localize "sta-officers-log.talents.type.label"}}</label>
        <select class="sta-talent-type-select">
          {{#each talentTypeOptions as |opt|}}
          <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
          {{/each}}
        </select>
      </div>
      <p class="sta-talent-type-hint">{{localize "sta-officers-log.talents.type.hint"}}</p>

      <div class="sta-talent-req-controls">
        <select class="sta-talent-add-select">
          <option value="">{{localize "sta-officers-log.talents.addRequirementCategory"}}</option>
          {{#each availableCategories as |cat|}}
          <option value="{{cat.value}}">{{cat.label}}</option>
          {{/each}}
        </select>
        <button type="button" class="button" data-action="onAddRequirement">
          {{localize "sta-officers-log.talents.addButton"}}
        </button>
      </div>

      <div class="sta-talent-req-list">
        {{#each requirementRows as |row|}}
        <div class="sta-talent-req-row" data-index="{{row.index}}" data-category="{{row.category}}">
          <div class="sta-talent-req-row-head">
            <div class="sta-talent-req-row-summary">{{row.summary}}</div>
            <div class="sta-talent-req-row-actions">
              <button type="button" class="sta-talent-req-delete" data-action="onDeleteRequirement" data-index="{{row.index}}">
                {{localize "sta-officers-log.talents.sheet.delete"}}
              </button>
            </div>
          </div>

          <div class="sta-talent-req-row-body">
            <div class="sta-talent-req-clauses">
              <div class="sta-talent-req-clause">
                {{#if row.clauseA.hasPresetOptions}}
                <select data-field="value" data-clause-index="0">
                  {{#each row.clauseA.options as |opt|}}
                  <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                  {{/each}}
                </select>
                {{else if row.clauseA.isLongText}}
                <textarea class="sta-talent-req-condition"
                          data-field="value"
                          data-clause-index="0"
                          rows="2"
                          placeholder="{{localize 'sta-officers-log.talents.conditionPlaceholder'}}">{{row.clauseA.value}}</textarea>
                {{else}}
                <input type="text"
                       data-field="value"
                       data-clause-index="0"
                       value="{{row.clauseA.value}}"
                       placeholder="{{localize 'sta-officers-log.talents.npcSpeciesPlaceholder'}}" />
                {{/if}}

                {{#if row.isNumeric}}
                <input type="number"
                       data-field="minimum"
                       data-clause-index="0"
                       value="{{row.clauseA.minimum}}"
                       min="0" />
                <span class="sta-talent-req-suffix">+</span>
                {{/if}}
              </div>

              {{#if row.showOperatorToggle}}
              <button type="button"
                      class="sta-talent-req-op-toggle"
                      data-field="operator"
                      data-value="{{row.operator}}"
                      data-action="onToggleOperator"
                      data-index="{{row.index}}">
                {{row.operator}}
              </button>

              <div class="sta-talent-req-clause">
                {{#if row.clauseB.hasPresetOptions}}
                <select data-field="value" data-clause-index="1">
                  {{#each row.clauseB.options as |opt|}}
                  <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                  {{/each}}
                </select>
                {{else if row.clauseB.isLongText}}
                <textarea class="sta-talent-req-condition"
                          data-field="value"
                          data-clause-index="1"
                          rows="2"
                          placeholder="{{localize 'sta-officers-log.talents.conditionPlaceholder'}}">{{row.clauseB.value}}</textarea>
                {{else}}
                <input type="text"
                       data-field="value"
                       data-clause-index="1"
                       value="{{row.clauseB.value}}"
                       placeholder="{{localize 'sta-officers-log.talents.npcSpeciesPlaceholder'}}" />
                {{/if}}

                {{#if row.isNumeric}}
                <input type="number"
                       data-field="minimum"
                       data-clause-index="1"
                       value="{{row.clauseB.minimum}}"
                       min="0" />
                <span class="sta-talent-req-suffix">+</span>
                {{/if}}
              </div>
              {{/if}}
            </div>
          </div>
        </div>
        {{/each}}
      </div>
      {{/unless}}
    </section>

    <section class="ol-section">
      <div class="ol-description-wrapper">
        <div class="ol-description-header">
          <div class="ol-field-label">{{localize 'sta.item.genericitem.description'}}</div>
        </div>
        <prose-mirror name="system.description"
                      data-document-u-u-i-d="{{item.uuid}}"
                      value="{{item.system.description}}"
                      collaborate="true"
                      toggled="true">
          {{{enrichedNotes}}}
        </prose-mirror>
      </div>
    </section>
  </div>
</div>
