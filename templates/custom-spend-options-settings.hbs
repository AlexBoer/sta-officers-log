<section class="sta-settings-form sta-custom-spend-settings">
  <p class="hint">{{klingonText (localize "sta-officers-log.settings.customSpendOptions.editorHint")}}</p>

  <div class="form-group">
    <h3>{{klingonText (localize "sta-officers-log.settings.customSpendOptions.awardTalentSelectorHeading")}}</h3>
    <div class="form-fields">
      <button type="button" class="dialog-button" data-action="open-award-talent-selector">
        <i class="fa-solid fa-medal"></i>
        {{klingonText (localize "sta-officers-log.settings.customSpendOptions.openAwardTalentSelector")}}
      </button>
    </div>
    <p class="hint">{{klingonText awardTalentSelectorHint}}</p>
  </div>

  <div class="form-group">
    <h3>{{klingonText (localize "sta-officers-log.settings.customSpendOptions.houseGloryEditorHeading")}}</h3>
    <div class="form-fields">
      <button type="button" class="dialog-button" data-action="open-house-glory-editor">
        <i class="fa-solid fa-house"></i>
        {{klingonText (localize "sta-officers-log.settings.customSpendOptions.houseGloryEditorButton")}}
      </button>
    </div>
    <p class="hint">{{houseGloryEditorHint}}</p>
  </div>

  <div class="form-group">
    <h3>{{klingonText (localize "sta-officers-log.settings.customSpendOptions.houseShameEditorHeading")}}</h3>
    <div class="form-fields">
      <button type="button" class="dialog-button" data-action="open-house-shame-editor">
        <i class="fa-solid fa-house"></i>
        {{klingonText (localize "sta-officers-log.settings.customSpendOptions.houseShameEditorButton")}}
      </button>
    </div>
    <p class="hint">{{houseShameEditorHint}}</p>
  </div>

  <div class="form-group">
    <h3>{{klingonText (localize "sta-officers-log.settings.customSpendOptions.acclaimEditorHeading")}}</h3>
    <div class="form-fields">
      <button type="button" class="dialog-button" data-action="open-acclaim-editor">
        <i class="fa-solid fa-cards-blank"></i>
        {{klingonText (localize "sta-officers-log.settings.customSpendOptions.openAcclaimEditor")}}
      </button>
    </div>
    <p class="hint">{{klingonText acclaimEditorHint}}</p>
  </div>

  <div class="form-group">
    <h3>{{klingonText (localize "sta-officers-log.settings.customSpendOptions.reprimandEditorHeading")}}</h3>
    <div class="form-fields">
      <button type="button" class="dialog-button" data-action="open-reprimand-editor">
        <i class="fa-solid fa-cards-blank"></i>
        {{klingonText (localize "sta-officers-log.settings.customSpendOptions.openReprimandEditor")}}
      </button>
    </div>
    <p class="hint">{{klingonText reprimandEditorHint}}</p>
  </div>

  <footer class="form-footer">
    <button type="submit" class="dialog-button"><i class="fa-solid fa-xmark"></i> {{klingonText (localize "sta-officers-log.settings.customSpendOptions.close")}}</button>
  </footer>
</section>
