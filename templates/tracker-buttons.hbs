<div class="sta-tracker-button-divider sta-officers-log-divider"></div>
<div class="sta-tracker-button-group sta-officers-log-group" data-module="{{moduleId}}">
  <button type="button" id="sta-officers-log-open-button" class="button sta-officers-log-open" title="{{localize "sta-officers-log.tools.conflictReference"}}" aria-label="{{localize "sta-officers-log.tools.conflictReference"}}" data-action="conflictReference">
    <i class="fa-solid fa-sitemap fa-fw" aria-hidden="true"></i>
  </button>
  <button type="button" id="sta-officers-log-manage-button" class="button sta-officers-log-manage" title="{{localize "sta-officers-log.tools.missionManager"}}" aria-label="{{localize "sta-officers-log.tools.missionManager"}}" data-action="missionManager">
    <i class="fa-solid fa-book fa-fw" aria-hidden="true"></i>
  </button>
  <button type="button" id="sta-officers-log-request-roll-button" class="button sta-officers-log-request-roll" title="{{localize "sta-officers-log.tools.requestRoll"}}" aria-label="{{localize "sta-officers-log.tools.requestRoll"}}" data-action="requestRoll">
    <i class="fa-solid fa-arrow-up-from-bracket fa-fw" aria-hidden="true"></i>
  </button>
</div>
