<section class="sta-settings-form sta-compendium-picker-settings">
  <p class="hint">{{localize "sta-officers-log.settings.compendiumPicker.editorHint"}}</p>

  {{!-- ── Focus Compendiums ────────────────────────────────────────────── --}}
  <div class="form-group">
    <label>{{localize "sta-officers-log.settings.compendiumPicker.focusLabel"}}</label>
    <p class="hint">{{localize "sta-officers-log.settings.compendiumPicker.focusHint"}}</p>
    <div class="form-fields" style="flex-direction:column;align-items:stretch;gap:0.4rem;">
      <div class="pack-badges" data-target="focusKeys">
        {{#each focusPacks}}
        <span class="pack-badge" data-key="{{key}}">
          <button type="button" class="pack-badge-remove" data-key="{{key}}" data-target="focusKeys"
            title="{{localize "sta-officers-log.settings.compendiumPicker.removePack"}}"
            aria-label="{{localize "sta-officers-log.settings.compendiumPicker.removePack"}}">
            <i class="fa-solid fa-times" aria-hidden="true"></i>
          </button>
          <span class="pack-badge-label" title="{{label}}">{{label}}</span>
        </span>
        {{else}}
        <span class="pack-badges-empty">{{localize "sta-officers-log.settings.compendiumPicker.noneSelected"}}</span>
        {{/each}}
      </div>
      <div class="pack-add-row">
        <select class="pack-select" data-target="focusKeys">
          <option value="">{{localize "sta-officers-log.settings.compendiumPicker.selectPlaceholder"}}</option>
          {{#each availablePacks}}
          <option value="{{packId}}">{{label}}</option>
          {{/each}}
        </select>
        <button type="button" class="pack-add-btn" data-target="focusKeys">
          <i class="fa-solid fa-plus"></i>
          {{localize "sta-officers-log.settings.compendiumPicker.addPack"}}
        </button>
      </div>
      <input type="hidden" name="focusKeys" value="{{focusKeysValue}}">
    </div>
  </div>

  {{!-- ── Talent Compendiums ───────────────────────────────────────────── --}}
  <div class="form-group">
    <label>{{localize "sta-officers-log.settings.compendiumPicker.talentLabel"}}</label>
    <p class="hint">{{localize "sta-officers-log.settings.compendiumPicker.talentHint"}}</p>
    <div class="form-fields" style="flex-direction:column;align-items:stretch;gap:0.4rem;">
      <div class="pack-badges" data-target="talentKeys">
        {{#each talentPacks}}
        <span class="pack-badge" data-key="{{key}}">
          <button type="button" class="pack-badge-remove" data-key="{{key}}" data-target="talentKeys"
            title="{{localize "sta-officers-log.settings.compendiumPicker.removePack"}}"
            aria-label="{{localize "sta-officers-log.settings.compendiumPicker.removePack"}}">
            <i class="fa-solid fa-times" aria-hidden="true"></i>
          </button>
          <span class="pack-badge-label" title="{{label}}">{{label}}</span>
        </span>
        {{else}}
        <span class="pack-badges-empty">{{localize "sta-officers-log.settings.compendiumPicker.noneSelected"}}</span>
        {{/each}}
      </div>
      <div class="pack-add-row">
        <select class="pack-select" data-target="talentKeys">
          <option value="">{{localize "sta-officers-log.settings.compendiumPicker.selectPlaceholder"}}</option>
          {{#each availablePacks}}
          <option value="{{packId}}">{{label}}</option>
          {{/each}}
        </select>
        <button type="button" class="pack-add-btn" data-target="talentKeys">
          <i class="fa-solid fa-plus"></i>
          {{localize "sta-officers-log.settings.compendiumPicker.addPack"}}
        </button>
      </div>
      <input type="hidden" name="talentKeys" value="{{talentKeysValue}}">
    </div>
  </div>


  {{!-- ── Include built-in STA packs ───────────────────────────────────── --}}
  <div class="form-group">
    <label>{{localize "sta-officers-log.settings.compendiumPicker.includeBuiltinName"}}</label>
    <p class="hint">{{localize "sta-officers-log.settings.compendiumPicker.includeBuiltinHint"}}</p>
    <div class="form-fields">
      <input type="checkbox" name="talentIncludeBuiltin" {{#if talentIncludeBuiltin}}checked{{/if}}>
    </div>
  </div>

  <footer class="form-footer">
    <button type="submit" class="dialog-button">
      <i class="fa-solid fa-save"></i>
      {{localize "sta-officers-log.settings.compendiumPicker.save"}}
    </button>
  </footer>
</section>
