<details class="sta-callbacks-log-meta" {{#if isOpen}}open{{/if}}>
  <summary class="sta-callbacks-log-meta-summary">Edit Log Data</summary>

  {{#if showMilestoneSelect}}
  <div class="column sta-milestone-select-wrapper">
    <div class="title">Milestone</div>
    <select data-sta-callbacks-field="callbackLinkMilestoneId" title="Associate a Milestone/Arc with this log's callbackLink metadata">
      <option value="">— None —</option>
      {{#each milestones}}
      <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
  {{/if}}

  {{#if showTraumaCheckbox}}
  <div class="row sta-log-created-with-trauma-row">
    <div class="sta-log-meta-field" title="{{traumaTooltip}}">
      <span class="sta-log-meta-label">{{traumaLabel}}</span>
      <input type="checkbox" data-sta-callbacks-field="createdWithTrauma" {{#if createdWithTrauma}}checked{{/if}}>
    </div>
    <div class="sta-log-meta-field" title="Show or hide the 'Choose Milestone/Arc' button on this log.">
      <span class="sta-log-meta-label">Show milestone/arc button</span>
      <input type="checkbox" data-sta-callbacks-field="showMilestoneArcButton" {{#if showMilestoneArcButton}}checked{{/if}}>
    </div>
    <div class="sta-log-meta-field" title="Set a custom creation date for this log (overrides the actual creation timestamp for sorting).">
      <span class="sta-log-meta-label">Custom Date</span>
      <div class="sta-custom-date-input-row">
        <input type="date" data-sta-callbacks-field="customDate" value="{{customDate}}">
        <button type="button" data-sta-callbacks-action="clearCustomDate" title="Clear custom date">✕</button>
      </div>
    </div>
  </div>
  {{/if}}
</details>
