<div class="form-group">
  <label>{{localize "sta-officers-log.dialog.addCharacter.characterLabel"}}</label>
  <select name="actorId">
    {{#each available}}
      <option value="{{id}}" {{#if isSelected}}selected{{/if}}>{{name}}</option>
    {{/each}}
    {{#each already}}
      <option value="{{id}}" disabled>{{name}} ({{localize "sta-officers-log.dialog.addCharacter.alreadyInMission"}})</option>
    {{/each}}
  </select>
  <p class="hint">{{localize "sta-officers-log.dialog.addCharacter.hint"}}</p>
</div>

<div class="form-group">
  <label class="checkbox">
    <input type="checkbox" name="createLog" checked />
    {{localize "sta-officers-log.dialog.addCharacter.createLog"}}
  </label>
</div>

<div class="form-group">
  <label class="checkbox">
    <input type="checkbox" name="openLog" />
    {{localize "sta-officers-log.dialog.addCharacter.openLog"}}
  </label>
</div>
